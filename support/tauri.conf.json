{
  "productName": "OffMessenger Support",
  "version": "0.1.0",
  "identifier": "com.offmessenger.support",
  "build": {
    "beforeDevCommand": "npm run dev:support",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:support",
    "frontendDist": "../dist/support"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OffMessenger Support",
        "url": "index.html",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "visible": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "wix": { "language": ["en-US"] },
      "nsis": { "installMode": "currentUser" }
    },
    "category": "Business",
    "shortDescription": "Moderation & role management console",
    "longDescription": "OffMessenger Support — companion app for staff: complaints queue, user search, role assignment."
  }
}
