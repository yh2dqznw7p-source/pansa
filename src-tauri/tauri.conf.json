{
  "productName": "OffMessenger",
  "version": "0.1.0",
  "identifier": "com.offmessenger.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OffMessenger",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "transparent": true,
        "visible": true,
        "resizable": true,
        "center": true
      },
      {
        "label": "support",
        "title": "OffMessenger Support",
        "url": "support.html",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": true,
        "visible": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": ["en-US", "ru-RU"]
      },
      "nsis": {
        "installMode": "perUser",
        "languages": ["English", "Russian"]
      }
    },
    "category": "SocialNetworking",
    "shortDescription": "OffMessenger — secure messenger with liquid glass UI",
    "longDescription": "OffMessenger is a desktop messenger with token-based top-up, chats, privacy controls, themes, and companion Support console for moderation and role management."
  },
  "plugins": {}
}
