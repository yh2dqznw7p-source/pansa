{
  "identifier": "default",
  "description": "Default capability for OffMessenger",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "shell:allow-open",
    "shell:allow-spawn",
    "shell:allow-execute"
  ]
}
